    {
      "title": "Add a model without a restart",
      "caption": "Saving the file wakes the watcher, which validates and swaps the config atomically. In-flight streams keep the config they started on.",
      "blocks": [
        {
          "display": "curl -s -w '\\nstatus=%{http_code}\\n' \\\n  -H 'content-type: application/json' \\\n  -d '{\"model\":\"fast-chat\",\"messages\":[]}' \\\n  localhost:8080/v1/chat/completions",
          "output": [
            {
              "text": "{\"error\":{\"message\":\"invalid request: unknown model `fast-chat`\",\"type\":\"invalid_request_error\",\"param\":null,\"code\":\"invalid_request\"}}",
              "kind": "json",
              "gap": 0.058
            },
            {
              "text": "status=400",
              "kind": "json",
              "gap": 0.0
            }
          ]
        },
        {
          "display": "cat >> demo/oxide.toml <<'EOF'\n[models.\"fast-chat\"]\nprimary = \"mock_backup/gpt-4o-mini\"\nEOF",
          "output": [
            {
              "text": "2026-11-01T13:20:15.013835Z  INFO oxide_route::config::watcher: configuration reloaded config=demo/oxide.toml",
              "kind": "log",
              "gap": 0.0
            }
          ]
        },
        {
