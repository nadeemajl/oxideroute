    {
      "title": "Validate before you run",
      "caption": "`validate` parses the TOML, interpolates ${ENV}, checks every upstream reference and reports the topology \u2014 without binding a port.",
      "blocks": [
        {
          "display": "export PATH=\"$PWD/target/debug:$PATH\"",
          "output": []
        },
        {
          "display": "oxide validate --config demo/oxide.toml",
          "output": [
            {
              "text": "configuration OK: demo/oxide.toml",
              "kind": "kv",
              "gap": 0.119
            },
            {
              "text": "  listen:               127.0.0.1:8080",
              "kind": "kv",
              "gap": 0.004
            },
            {
              "text": "  admin_listen:         127.0.0.1:9090  (/metrics, /healthz)",
              "kind": "kv",
              "gap": 0.0
            },
            {
              "text": "  providers:            4",
              "kind": "kv",
              "gap": 0.0
            },
            {
              "text": "  models:               4",
              "kind": "kv",
              "gap": 0.0
            },
            {
              "text": "  routing rules:        1",
              "kind": "kv",
              "gap": 0.0
            },
            {
              "text": "  rate-limited tenants: 1",
              "kind": "kv",
              "gap": 0.0
            }
          ]
        }
      ]
