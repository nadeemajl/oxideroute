    {
      "title": "Start the service",
      "caption": "Two listeners: client traffic on 8080, operator traffic on 9090. Scrape traffic never touches the ingress.",
      "blocks": [
        {
          "display": "oxide serve --config demo/oxide.toml &",
          "output": [
            {
              "text": "2026-11-01T13:20:10.724136Z  INFO oxide: oxide serving address=127.0.0.1:8080 config=demo/oxide.toml",
              "kind": "log",
              "gap": 0.0
            },
            {
              "text": "2026-11-01T13:20:10.737496Z  INFO oxide: admin listener serving /metrics and /healthz address=127.0.0.1:9090",
              "kind": "log",
              "gap": 0.0
            }
          ]
        },
        {
          "display": "curl -s localhost:8080/healthz",
          "output": [
            {
              "text": "ok",
              "kind": "out",
              "gap": 0.049
            }
          ]
        }
      ]
    },
