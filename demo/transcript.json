    {
      "title": "Shut down without dropping a stream",
      "caption": "SIGTERM stops accepting, drains in-flight requests, and exits at the deadline instead of waiting for an orchestrator to SIGKILL it.",
      "blocks": [
        {
          "display": "kill -TERM %1",
          "output": [
            {
              "text": "2026-11-01T13:20:16.251636Z  INFO oxide: shutting down; draining in-flight requests drain_ms=5000",
              "kind": "log",
              "gap": 0.0
            },
            {
              "text": "2026-11-01T13:20:16.253692Z  INFO oxide: shutdown complete",
              "kind": "log",
              "gap": 0.0
            }
          ]
        }
