    {
      "title": "Fail over a provider that stalls after 200",
      "caption": "The primary answered 200 and then sent only `: ping`. The watchdog fired at 800 ms, and the client got a normal answer from the fallback.",
      "blocks": [
        {
          "display": "curl -s -o /dev/null -D - \\\n  -w 'ttfb=%{time_starttransfer}s total=%{time_total}s\\n' \\\n  -H 'content-type: application/json' -d @demo/smart.json \\\n  localhost:8080/v1/chat/completions | grep -E 'HTTP|x-oxide|ttfb'",
          "output": [
            {
              "text": "HTTP/1.1 200 OK",
              "kind": "header",
              "gap": 1.301
            },
            {
              "text": "x-oxide-request-id: req_6afd1fd68ba645f7bc1cff0328614599",
              "kind": "header",
              "gap": 0.0
            },
            {
              "text": "x-oxide-upstream: mock_backup/gpt-4o-mini",
              "kind": "header",
              "gap": 0.0
            },
            {
              "text": "ttfb=0.846266s total=1.246663s",
              "kind": "out",
              "gap": 0.0
            }
          ]
        },
        {
          "display": "curl -s localhost:9090/metrics | grep '^oxide_fallback'",
          "output": [
            {
              "text": "oxide_fallback_triggered_total{from_provider=\"mock_primary\",to_provider=\"mock_backup\",reason=\"ttft_timeout_exceeded (800ms)\"} 1",
              "kind": "out",
              "gap": 0.056
            }
          ]
        }
      ]
    },
    {
      "title": "Retry on an upstream 429",
      "caption": "429 is in `retry_on_status`, so the request moves to the next candidate. The vendor's error never reaches the client.",
      "blocks": [
        {
          "display": "curl -s -o /dev/null -D - -H 'content-type: application/json' \\\n  -d @demo/flaky.json localhost:8080/v1/chat/completions \\\n  | grep -E 'HTTP|x-oxide-upstream'",
          "output": [
            {
              "text": "HTTP/1.1 200 OK",
              "kind": "header",
              "gap": 0.475
            },
            {
              "text": "x-oxide-upstream: mock_backup/gpt-4o-mini",
              "kind": "header",
              "gap": 0.0
            }
          ]
        },
        {
          "display": "curl -s localhost:9090/metrics | grep '^oxide_fallback'",
          "output": [
            {
              "text": "oxide_fallback_triggered_total{from_provider=\"mock_flaky\",to_provider=\"mock_backup\",reason=\"http_status_429\"} 1",
              "kind": "out",
              "gap": 0.055
            },
            {
              "text": "oxide_fallback_triggered_total{from_provider=\"mock_primary\",to_provider=\"mock_backup\",reason=\"ttft_timeout_exceeded (800ms)\"} 1",
              "kind": "out",
              "gap": 0.0
            }
          ]
        }
      ]
