    {
      "id": "guarantee",
      "type": "text",
      "x": 980,
      "y": 300,
      "width": 275.45,
      "height": 65.0,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1485936856,
      "version": 1,
      "versionNonce": 2112252597,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "A stream is never re-routed mid-flight: the\nexecutor holds its own Arc for the whole\nresponse, so a reload cannot change the\nupstream halfway through a sentence.",
      "originalText": "A stream is never re-routed mid-flight: the\nexecutor holds its own Arc for the whole\nresponse, so a reload cannot change the\nupstream halfway through a sentence.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true,
      "index": "a22"
    },
    {
      "id": "notes",
      "type": "text",
      "x": 60,
      "y": 600,
      "width": 651.22,
      "height": 48.75,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 18589324,
      "version": 1,
      "versionNonce": 660272231,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "A rejected reload keeps the previous config active and increments\noxide_reload_total{result=\"rejected\",source=\"file\"|\"signal\"}.\nQuota buckets reset on reload; spend does not \u2014 resetting quotas must not forgive a spent budget.",
      "originalText": "A rejected reload keeps the previous config active and increments\noxide_reload_total{result=\"rejected\",source=\"file\"|\"signal\"}.\nQuota buckets reset on reload; spend does not \u2014 resetting quotas must not forgive a spent budget.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true,
      "index": "a23"
    },
    {
      "id": "why",
      "type": "text",
      "x": 60,
      "y": 664,
