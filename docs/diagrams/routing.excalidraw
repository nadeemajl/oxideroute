    {
      "id": "rule_note",
      "type": "text",
      "x": 620,
      "y": 240,
      "width": 296.14,
      "height": 81.25,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 477734243,
      "version": 1,
      "versionNonce": 282583198,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "A rule's route_to may name a virtual model\nor a provider/model directly. If no rule\nmatches, the requested model must exist in\n[models] \u2014 an unknown name is a 400, not a\nfallback candidate.",
      "originalText": "A rule's route_to may name a virtual model\nor a provider/model directly. If no rule\nmatches, the requested model must exist in\n[models] \u2014 an unknown name is a 400, not a\nfallback candidate.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true,
      "index": "a17"
    },
    {
      "id": "order_note",
      "type": "text",
      "x": 620,
      "y": 356,
      "width": 295.66,
      "height": 65.0,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 38584323,
      "version": 1,
      "versionNonce": 1945929798,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "The strategy orders candidates; it never\nremoves one. A tripped breaker is skipped by\nthe executor at dispatch time, which costs\nnothing \u2014 no timeout is paid.",
      "originalText": "The strategy orders candidates; it never\nremoves one. A tripped breaker is skipped by\nthe executor at dispatch time, which costs\nnothing \u2014 no timeout is paid.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true,
      "index": "a18"
    },
    {
      "id": "ewma_note",
      "type": "text",
      "x": 620,
      "y": 470,
      "width": 296.97,
      "height": 48.75,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 723239940,
      "version": 1,
      "versionNonce": 1485372564,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Unmeasured targets (EWMA = 0) sort last, so\nan unknown upstream cannot win an election\nsimply because nobody has called it yet.",
      "originalText": "Unmeasured targets (EWMA = 0) sort last, so\nan unknown upstream cannot win an election\nsimply because nobody has called it yet.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true,
      "index": "a19"
    },
