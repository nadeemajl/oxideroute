      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 808885218,
      "version": 1,
      "versionNonce": 1314019197,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Caveats worth knowing:\n\u2022 Streaming responses carry no usage block in OpenAI's format, so a streamed request is billed on the prompt estimate only.\n\u2022 Tool calls and multimodal content pass through on the OpenAI adapter; the translated adapters cover text deltas and stop reasons.",
      "originalText": "Caveats worth knowing:\n\u2022 Streaming responses carry no usage block in OpenAI's format, so a streamed request is billed on the prompt estimate only.\n\u2022 Tool calls and multimodal content pass through on the OpenAI adapter; the translated adapters cover text deltas and stop reasons.",
