      "versionNonce": 600145035,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Why this matters: a client can switch a model from GPT-4o to Claude to Bedrock by editing one line of TOML.\nThe SDK keeps parsing the same chunk shape, so failover across vendors is invisible to application code.",
      "originalText": "Why this matters: a client can switch a model from GPT-4o to Claude to Bedrock by editing one line of TOML.\nThe SDK keeps parsing the same chunk shape, so failover across vendors is invisible to application code.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true,
      "index": "a26"
    },
    {
      "id": "caveat",
      "type": "text",
      "x": 60,
      "y": 636,
      "width": 867.52,
      "height": 48.75,
      "angle": 0,
      "strokeColor": "#495057",
