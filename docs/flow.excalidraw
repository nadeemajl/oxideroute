    {
      "id": "detail_text",
      "type": "text",
      "x": 898,
      "y": 740,
      "width": 294,
      "height": 170,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1289637704,
      "version": 1,
      "versionNonce": 2038974822,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "per candidate, in order\n1 \u00b7 breaker open? \u2192 skip\n2 \u00b7 dispatch, TTFT watchdog\n3 \u00b7 success \u2192 record TTFT\n4 \u00b7 retryable \u2192 record failure\n5 \u00b7 non-retryable \u2192 return as-is\n\nstreaming gates on the first frame;\nbuffered waits for the body.",
      "originalText": "per candidate, in order\n1 \u00b7 breaker open? \u2192 skip\n2 \u00b7 dispatch, TTFT watchdog\n3 \u00b7 success \u2192 record TTFT\n4 \u00b7 retryable \u2192 record failure\n5 \u00b7 non-retryable \u2192 return as-is\n\nstreaming gates on the first frame;\nbuffered waits for the body.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true,
